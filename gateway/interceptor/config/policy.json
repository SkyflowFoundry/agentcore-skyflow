{
  "defaults": {
    "request": {
      "action": "deidentify",
      "tokenType": "vault_token"
    },
    "response": {
      "action": "reidentify"
    },
    "entities": [
      "name",
      "email_address",
      "phone_number",
      "ssn",
      "credit_card",
      "dob",
      "location"
    ],
    "scope": {
      "minLength": 8,
      "includeKeys": [
        "*"
      ],
      "excludeKeys": [
        "api_key",
        "authorization",
        "request_id",
        "session_id",
        "cursor",
        "type",
        "url"
      ]
    },
    "failure": {
      "onError": "fail_closed"
    },
    "logUpstreamPayloads": false
  },
  "toolNameSeparator": "___",
  "httpPayloads": {
    "action": "block"
  },
  "inference": {
    "models": [
      "*"
    ],
    "request": {
      "action": "deidentify",
      "tokenType": "vault_token",
      "parts": [
        "system",
        "user",
        "assistant",
        "tool_call",
        "tool_result",
        "document",
        "image"
      ],
      "systemNote": true
    },
    "response": {
      "action": "reidentify",
      "parts": [
        "text",
        "tool_call"
      ],
      "only": "minted_for_request"
    },
    "scope": {
      "minLength": 3
    },
    "attachments": {
      "maxBytes": 2097152
    },
    "failure": {
      "onError": "fail_closed"
    }
  },
  "overrides": [
    {
      "servers": [
        "",
        "*"
      ],
      "tools": [
        "x_amz_bedrock_agentcore_search"
      ],
      "request": {
        "action": "none"
      },
      "response": {
        "action": "none"
      }
    },
    {
      "servers": [
        "exa"
      ],
      "tools": [
        "web_search_exa"
      ],
      "entities": [
        "name",
        "email_address",
        "phone_number",
        "ssn",
        "credit_card",
        "dob"
      ]
    },
    {
      "servers": [
        "exa"
      ],
      "tools": [
        "web_fetch_exa"
      ],
      "request": {
        "action": "none"
      },
      "response": {
        "action": "deidentify",
        "tokenType": "counter"
      }
    },
    {
      "servers": [
        "s3"
      ],
      "tools": [
        "list_documents"
      ],
      "request": {
        "action": "none"
      },
      "response": {
        "action": "none"
      }
    },
    {
      "servers": [
        "s3"
      ],
      "tools": [
        "get_document"
      ],
      "request": {
        "action": "none"
      },
      "response": {
        "action": "none"
      },
      "files": {
        "action": "deidentify",
        "directions": [
          "response"
        ],
        "fields": [
          "content[*].text.url"
        ],
        "urlPatterns": [
          "https://agentcore-skyflow-files-*.s3.amazonaws.com/*",
          "https://agentcore-skyflow-files-*.s3.*.amazonaws.com/*",
          "https://agentcore-skyflow-files-*.s3.dualstack.*.amazonaws.com/*"
        ],
        "maxFiles": 1,
        "tokenType": "vault_token",
        "destinations": {
          "default": "table1.{entity}_entity"
        },
        "maxFileBytes": 524288
      }
    }
  ]
}
