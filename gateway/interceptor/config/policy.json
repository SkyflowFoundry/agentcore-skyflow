{
  "defaults": {
    "request": {
      "action": "deidentify",
      "tokenType": "vault_token"
    },
    "response": {
      "action": "reidentify"
    },
    "entities": [
      "name",
      "email_address",
      "phone_number",
      "ssn",
      "credit_card",
      "dob",
      "location"
    ],
    "scope": {
      "minLength": 8,
      "includeKeys": [
        "*"
      ],
      "excludeKeys": [
        "api_key",
        "authorization",
        "request_id",
        "session_id",
        "cursor",
        "type",
        "url"
      ]
    },
    "failure": {
      "onError": "fail_closed"
    },
    "logUpstreamPayloads": true
  },
  "toolNameSeparator": "___",
  "overrides": [
    {
      "servers": [
        "",
        "*"
      ],
      "tools": [
        "x_amz_bedrock_agentcore_search"
      ],
      "request": {
        "action": "none"
      },
      "response": {
        "action": "none"
      }
    },
    {
      "servers": [
        "exa"
      ],
      "tools": [
        "web_fetch_exa"
      ],
      "request": {
        "action": "none"
      },
      "response": {
        "action": "deidentify",
        "tokenType": "vault_token"
      }
    },
    {
      "servers": [
        "s3"
      ],
      "tools": [
        "get_document"
      ],
      "request": {
        "action": "none"
      },
      "response": {
        "action": "none"
      },
      "files": {
        "action": "deidentify",
        "directions": [
          "response"
        ],
        "fields": [
          "content[*].text.url"
        ],
        "urlPatterns": [
          "https://agentcore-skyflow-files-*.s3.amazonaws.com/*"
        ],
        "maxFiles": 1,
        "tokenType": "counter"
      }
    }
  ]
}
