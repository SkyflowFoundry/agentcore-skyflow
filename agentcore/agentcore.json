{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "agentflow",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "agentflow"
  },
  "runtimes": [
    {
      "name": "Flow",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/Flow/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "HTTP"
    }
  ],
  "memories": [
    {
      "name": "FlowMemory",
      "eventExpiryDuration": 30,
      "strategies": []
    }
  ],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [
    {
      "name": "SkyflowGateway",
      "description": "MCP gateway fronting upstream servers, with Skyflow de-identify/re-identify interceptors",
      "protocolType": "MCP",
      "authorizerType": "AWS_IAM",
      "enableSemanticSearch": true,
      "exceptionLevel": "DEBUG",
      "targets": [
        {
          "name": "exa",
          "targetType": "mcpServer",
          "endpoint": "https://mcp.exa.ai/mcp",
          "outboundAuth": {
            "type": "NONE"
          }
        },
        {
          "name": "s3",
          "targetType": "lambda",
          "compute": {
            "host": "Lambda",
            "implementation": {
              "language": "Python",
              "path": "gateway/targets/s3",
              "handler": "handler.lambda_handler"
            },
            "pythonVersion": "PYTHON_3_13",
            "timeout": 30,
            "memorySize": 256,
            "iamPolicy": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:ListBucket"
                  ],
                  "Resource": "arn:aws:s3:::agentcore-skyflow-files-571930033416"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject"
                  ],
                  "Resource": "arn:aws:s3:::agentcore-skyflow-files-571930033416/*"
                }
              ]
            }
          },
          "toolDefinitions": [
            {
              "name": "list_documents",
              "description": "List the documents available in the document store. Returns keys and sizes but no file contents.",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "prefix": {
                    "type": "string",
                    "description": "Only list documents whose key starts with this prefix, for example samples/"
                  }
                }
              }
            },
            {
              "name": "get_document",
              "description": "Get a time-limited download URL for one document. Returns a URL rather than the file contents.",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "description": "The document key, for example samples/claim-note.txt"
                  },
                  "expires_in": {
                    "type": "integer",
                    "description": "Seconds until the URL expires. Defaults to 900 and is capped at 3600."
                  }
                },
                "required": [
                  "key"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "policyEngines": [],
  "configBundles": [
    {
      "name": "FlowConfig",
      "type": "ConfigurationBundle",
      "description": "Configuration for Flow \u2014 managed by agentcore CLI",
      "components": {
        "{{runtime:Flow}}": {
          "configuration": {
            "systemPrompt": "You are a helpful assistant. Use tools when appropriate.",
            "toolDescriptions": {
              "add_numbers": "Return the sum of two numbers"
            }
          }
        }
      },
      "branchName": "mainline",
      "commitMessage": "Initial configuration"
    }
  ],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "capacityProviders": [],
  "payments": []
}
