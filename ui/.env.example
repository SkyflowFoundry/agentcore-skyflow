# Copy to .env and fill in for local development.
#
# Region where the Flow AgentCore Runtime agent is deployed.
VITE_AGENT_REGION=us-east-1
#
# Full ARN of the Flow runtime. Find it with `agentcore status` or in the
# CloudFormation outputs of the agentcore CDK stack.
VITE_FLOW_AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:<ACCOUNT_ID>:runtime/Flow-XXXXXXXX
#
# Optional: the runtime endpoint qualifier to invoke (defaults to DEFAULT).
# VITE_FLOW_AGENT_QUALIFIER=DEFAULT
